{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc", ".yarnrc.yml", "tsconfig.json", "babel.config.js"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "!src/**/__tests__/**", "package.json", "tsconfig*.json"],
      "outputs": ["lib/**"]
    },
    "clean": { "cache": false },
    "generate:data": {
      "inputs": ["scripts/**"],
      "outputs": ["src/data/*.generated.ts"]
    }
  }
}
