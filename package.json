{
  "name": "password-intelligence-monorepo",
  "private": true,
  "version": "0.4.1",
  "description": "Monorepo for password-intelligence and react-native-password-intelligence.",
  "license": "MIT",
  "author": "mobilteknolojileri <mobilteknolojileri@gmail.com> (https://github.com/mobilteknolojileri)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mobilteknolojileri/react-native-password-intelligence.git"
  },
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "packages/*",
    "example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "lefthook install",
    "example": "yarn workspace react-native-password-intelligence-example",
    "core": "yarn workspace password-intelligence",
    "rn": "yarn workspace react-native-password-intelligence",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "generate:data": "yarn core run generate:data",
    "verify:data": "yarn generate:data && git diff --exit-code -- packages/core/src/data",
    "release": "release-it --only-version",
    "sync-versions": "node scripts/sync-versions.mjs",
    "check:versions": "node scripts/sync-versions.mjs --check"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@react-native/babel-preset": "0.83.0",
    "@react-native/eslint-config": "0.83.0",
    "@release-it/conventional-changelog": "^10.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.12",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-builder-bob": "^0.43.0",
    "react-test-renderer": "19.2.0",
    "release-it": "^19.0.4",
    "turbo": "^2.10.12",
    "typescript": "^5.9.2"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "hooks": {
      "after:bump": [
        "node scripts/sync-versions.mjs",
        "yarn install --mode=update-lockfile"
      ]
    },
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": false
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  }
}
