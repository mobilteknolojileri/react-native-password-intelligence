{
  "name": "password-intelligence",
  "version": "0.4.1",
  "description": "Framework-agnostic, Turkish-first password strength estimator. Regional pattern intelligence (names, surnames, football clubs, city plates, brands) on top of zxcvbn-ts, in a ~34 kB gzip default bundle.",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "react-native": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./dictionaries/tr": {
      "source": "./src/dictionaries/tr.ts",
      "import": {
        "types": "./lib/typescript/module/src/dictionaries/tr.d.ts",
        "default": "./lib/module/dictionaries/tr.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/dictionaries/tr.d.ts",
        "default": "./lib/commonjs/dictionaries/tr.js"
      }
    },
    "./translations/tr": {
      "source": "./src/translations/tr.ts",
      "import": {
        "types": "./lib/typescript/module/src/translations/tr.d.ts",
        "default": "./lib/module/translations/tr.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/translations/tr.d.ts",
        "default": "./lib/commonjs/translations/tr.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "THIRD_PARTY_NOTICES.md",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!*.log"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "del-cli lib",
    "build": "bob build",
    "generate:data": "node scripts/generate-data.mjs",
    "prepack": "yarn build"
  },
  "keywords": [
    "password-strength",
    "password-intelligence",
    "password",
    "zxcvbn",
    "zxcvbn-ts",
    "turkish",
    "turkce",
    "nist",
    "nist-800-63b",
    "blocklist",
    "security",
    "threat-intelligence",
    "cultural-awareness"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mobilteknolojileri/react-native-password-intelligence.git",
    "directory": "packages/core"
  },
  "author": "mobilteknolojileri <mobilteknolojileri@gmail.com> (https://github.com/mobilteknolojileri)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mobilteknolojileri/react-native-password-intelligence/issues"
  },
  "homepage": "https://mobilteknolojileri.github.io/react-native-password-intelligence/",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^3.0.4"
  },
  "devDependencies": {
    "@zxcvbn-ts/language-common": "^3.0.4",
    "del-cli": "^7.0.0",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.9.2"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
